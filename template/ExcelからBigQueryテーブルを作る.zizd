metadata:
  name: ExcelからBigQueryテーブルを作る
  mode: dataflow
  extension: .zizd
  execution_model: df
  category: etl
variables:
  start: []
steps:
- step_id: step1
  connector: csv_connector
  action: read_csv
  params:
    file_path: sample
    encoding: utf8
    delimiter: ','
    header_row: 1
    data_start_row: 2
    schema: '[]'
  output_variable: step1
  description: CSVからBigQueryテーブルを作る
  ui_position:
    x: 172
    y: 40
- step_id: step2
  connector: dataintegration_connector
  action: replace_fields_forrenamelist
  params:
    input_data: step1
    rename_list_path: config\rename.csv
  output_variable: step2
  description: フィールド名を変更する
  ui_position:
    x: 300
    y: 40
- step_id: step3
  connector: dataintegration_connector
  action: filter_rows
  params:
    input_data: step2
    conditions: '[]'
  output_variable: step3
  description: データ加工 / 条件指定
  ui_position:
    x: 428
    y: 40
- step_id: step4
  connector: bigquery_connector
  action: load_data
  params:
    project_id: project_name
    dataset_id: dataset_name
    table_id: table_name
    input_data: step3
    write_disposition: create_or_replace
    schema: '[]'
  output_variable: step4
  description: BigQuery / データロード
  ui_position:
    x: 556
    y: 40
flows:
  start: START
  end: END
  edges:
  - from: START
    to: step1
    order: 1
    kind: primary
  - from: step1
    to: step2
    order: 1
    kind: primary
  - from: step2
    to: step3
    order: 1
    kind: primary
  - from: step3
    to: step4
    order: 1
    kind: primary
  - from: step4
    to: END
    order: 0
notes:
- id: note_c9258074-e716-4a81-b055-5fcf325f6182
  x: 108
  y: 168
  w: 320
  h: 352
  text: 'step1：[Excel取込みステップ]をクリック

    　・画面右側

    　  「プレビュー表示」をクリックし対象ファイルを指定

    　・画面中央下部>スキーマ定義

    　  不要なカラムを確認して[ゴミ箱]

    　・画面右上

    　  実行[▶]ボタンをクリック


    step2：[カラム名変更]をクリック

    　※自動変更と明示変更ができます。

    　・画面右側

    　  実行[▶]ボタンをクリック


    step3：[フィルター]をクリック

    　・画面右側

    　  必要に応じてフィルター指定

    　・画面中央下部

    　  必要/不要のカラムをチェック

    　  実行[▶]ボタンをクリック'
  color: '#fff2a8'
  anchorNodeId: null
- id: note_c14cea97-fb34-4058-9d5f-9fda5bac95d9
  x: 492
  y: 168
  w: 288
  h: 160
  text: 'step4：[BigQuery]へデータロード

    　・画面右側

    　  プロジェクト、データセット、テーブル名の指定

    　  実行[▶]ボタンをクリック

    　・画面中央下部>データ出力

    　  URLがでるので、これでテーブル確認できます。'
  color: '#cfe4ff'
  anchorNodeId: null
